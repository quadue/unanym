{
  "name": "unanym",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Independently hosted community identity, selective disclosure and WordPress sign-in.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/standalone/server.js",
    "build": "node scripts/build.js",
    "demo": "node scripts/demo-independent.js",
    "demo:independent": "node scripts/demo-independent.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "verify": "npm run check:release && npm run build && npm test && npm run test:browser",
    "start:standalone": "node src/standalone/server.js",
    "start:legacy": "node src/server.js",
    "quickstart": "node scripts/quickstart.js",
    "check:release": "node scripts/check-release.js",
    "start:frrn": "node src/frrn/server.js",
    "demo:v1": "node scripts/demo-v1.js"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "express": "5.2.1",
    "jose": "6.2.12",
    "nodemailer": "10.0.10",
    "oidc-client-ts": "3.5.0",
    "oidc-provider": "9.12.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3"
  },
  "license": "Apache-2.0"
}
